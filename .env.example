# VECAI backend environment configuration
# Copy this file to .env and set values for your environment.
# Never commit real credentials or production secrets.

APP_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5433/vecai?sslmode=disable
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
UPLOAD_DIR=backend/uploads
MIGRATIONS_PATH=backend/db/migrations
